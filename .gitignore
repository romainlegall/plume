# Dossier personnel macOS
.DS_Store

# Les secrets de production restent sur le NAS, jamais dans le depot
/server/env.production
/.env

# Donnees : montees en volume sur le NAS, jamais versionnees
/data
*.mbox
*.mboxo
/deploy.log

# Rails
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep

# Fichiers generes
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules

# Cles de chiffrement : propres a chaque machine
/config/master.key
/config/credentials/*.key