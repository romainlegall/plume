# A copier en .env sur le NAS, puis a remplir.
# Les deux variables sans valeur par defaut sont exigees : le conteneur refuse
# de demarrer tant qu'elles sont absentes.

# Genere une fois : openssl rand -hex 64
SECRET_KEY_BASE=

# Identifiants de la base PostgreSQL existante sur le NAS
PLUME_DB_HOST=192.168.1.30
PLUME_DB_PORT=5434
PLUME_DB_USER=postgres
PLUME_DB_PASSWORD=
PLUME_DB_NAME=plume_production