# plume — configuration de production sur le NAS
#
# A copier en server/env.production, puis a remplir.
#
#   cp server/env.production.example server/env.production
#
# Ce fichier contient des secrets : il est dans le .gitignore et ne doit jamais
# etre versionne.

# ---------------------------------------------------------------------------
# GitHub — l'image est construite en cloneant le depot
# ---------------------------------------------------------------------------
GITHUB_REPO=romainlegall/plume
GITHUB_BRANCH=main
# Jeton avec lecture seule sur le depot. Pour un depot prive :
#   https://github.com/settings/tokens  ->  Fine-grained token, lecture seule
# Si le depot est prive et le jeton vide, le clone echouera.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Rails
# ---------------------------------------------------------------------------
RAILS_ENV=production
RAILS_MAX_THREADS=5
RAILS_MASTER_KEY=
# openssl rand -hex 64
SECRET_KEY_BASE=

# ---------------------------------------------------------------------------
# Base de donnees
#
# La base partagee du NAS tourne dans le conteneur "db" sur le reseau
# shared-database_default. L'URL est definie dans docker-compose.yml.
# Creer la base une fois, si elle n'existe pas :
#   docker exec shared_postgres_db createdb -U postgres plume_production
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Archive et Pieces jointes
# ---------------------------------------------------------------------------
# Adresses qui identifient vos envois, separees par des virgules.
PLUME_OWN_ADDRESSES=legall.romain@gmail.com