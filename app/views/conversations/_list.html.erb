<% conversations ||= @conversations %>
<% pagy ||= @pagy %>

<header class="border-b border-stone-200 px-4 py-2">
  <h1 class="truncate text-sm font-semibold">
    <%= sidebar_labels.find { |e| e.slug == current_label_slug }&.name || "Messages" %>
  </h1>
</header>

<% if conversations.blank? %>
  <p class="p-8 text-center text-sm text-stone-400">Aucun message dans cette boite.</p>
<% else %>
  <ul class="min-h-0 flex-1 overflow-y-auto">
    <%= render partial: "conversations/row", collection: conversations, as: :conversation %>
  </ul>

  <%= render "shared/pagination", pagy: pagy %>
<% end %>