<% content_for :title, @conversation.subject %>

<%# La colonne de liste reste visible sur grand ecran, comme dans un client
    classique ; sur mobile elle cede la place a la conversation. %>
<section class="<%= class_names("min-w-0 flex-1 flex-col border-r border-stone-200 bg-white hidden md:flex") %>">
  <%= render "conversations/list", conversations: @sidebar_conversations, pagy: @sidebar_pagy %>
</section>

<section class="flex min-w-0 flex-1 flex-col bg-stone-50">
  <header class="border-b border-stone-200 bg-white px-4 py-2.5">
    <div class="flex items-center gap-2">
      <%= link_to "← Liste", label_conversations_path(slug: current_label_slug),
            class: "text-sm text-stone-500 hover:text-stone-900 md:hidden" %>

      <h1 class="min-w-0 flex-1 truncate text-sm font-semibold"><%= @conversation.subject %></h1>

      <% if @conversation.messages.size > 1 %>
        <span class="shrink-0 rounded bg-stone-100 px-2 py-0.5 text-xs text-stone-600">
          <%= pluralize @conversation.messages.size, "message" %>
        </span>
      <% end %>
    </div>

    <p class="mt-0.5 truncate text-xs text-stone-500">
      <%= @conversation.participants.join(", ").presence || "—" %>
    </p>
  </header>

  <div class="min-h-0 flex-1 overflow-y-auto p-4">
    <div class="mx-auto max-w-3xl space-y-4">
      <%= render partial: "conversations/message", collection: @messages, as: :message %>
    </div>
  </div>
</section>